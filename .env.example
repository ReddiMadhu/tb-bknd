# LLM / OpenAI Configuration
# The code expects these three variables. For Azure OpenAI, set them to your
# Azure resource values. To use Google Gemini (Generative Language API), set
# the same variables to your Google API key and endpoint as shown below.

# Example (Azure OpenAI):
# AZURE_OPENAI_ENDPOINT=https://<your-azure-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=<your_azure_openai_api_key>
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# Example (Google Gemini):
# - Set `AZURE_OPENAI_API_KEY` to your Google API key (X-goog-api-key)
# - Set `AZURE_OPENAI_ENDPOINT` to the Gemini base URL
#   e.g. https://generativelanguage.googleapis.com/v1beta/openai/
# - Set `AZURE_OPENAI_DEPLOYMENT_NAME` to the Gemini model name
#   e.g. gemini-2.0-flash

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# LLM Settings
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# System Configuration
MAX_FILES_LIMIT=5
ENABLE_CACHING=true
PARALLEL_PROCESSING=true
LOG_LEVEL=INFO

# Business Context Validation - ENABLED BY DEFAULT
# Set to 'false' to disable LLM-based business validation
ENABLE_LLM_VALIDATION=true

# SECURITY: Never commit real API keys. Copy this file to '.env' and fill
# values there. Keep credentials out of source control.
